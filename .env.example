# 复制为 .env 后按需覆盖；本机已在系统环境变量中配置的值无需重复填写
# 注意：.env 已列入 .gitignore，切勿提交真实凭证

# 服务端口（Railway 会自动注入 PORT，本地默认 3000）
PORT=3000

# SQLite 数据库路径（Railway 上应指向挂载卷，如 /data/app.db）
DB_PATH=./data/app.db

# ---- AI 对话模块（M6+ 才用到，第一阶段无需配置）----
# 调用格式为 Anthropic Messages API，实际模型由 BASE_URL 指向的端点决定
# （本机该端点指向 DeepSeek，因此对话能力来自 DeepSeek 而非 Claude）
# 凭证一律从环境变量读取，代码中不硬编码、不打印、不写盘
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# ---- 学习助教（Dify 托管的 Agent）----
# 在 Dify 应用的「访问 API」页生成 Key，填到 DIFY_API_KEY
# 同样是凭证，只进环境变量，不要提交进仓库
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
